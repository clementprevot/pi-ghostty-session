{
	"name": "@clementprevot/pi-ghostty-session",
	"version": "0.2.0",
	"description": "Pi extension that opens new pi sessions in Ghostty on macOS, one in a split, tab, or window, or several grouped in titled tabs, started in the folder and with the prompt you choose",
	"keywords": [
		"pi-package",
		"pi-extension",
		"ghostty",
		"terminal",
		"session",
		"split",
		"applescript"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clementprevot/pi-ghostty-session.git"
	},
	"engines": {
		"node": ">=22.6"
	},
	"files": [
		"index.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@types/node": "^24.0.0",
		"typebox": "*",
		"typescript": "^5.9.0"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	}
}
